    SELECT
        pd.[Fecha de Pedido],
        pd.[Fecha de Entrega_date],
        pd.[Solic.],
        pd.[Material],
        pd.[ClVt],
        pd.[Hls],
        pd.[Status],
        pd.[Motivo de Rechazo],
        pd.[Month],
        pd.[Year],
        RIGHT('0' + CAST(MONTH(pd.[Fecha de Entrega_date]) AS VARCHAR(2)), 2) AS [Month Entrega],
        CAST(YEAR(pd.[Fecha de Entrega_date]) AS VARCHAR(4)) AS [Year Entrega]
    FROM Pedidos_Detailed pd
    WHERE pd.[ClVt] IN ('ZNP1','ZNPV','ZNO1','ZNOB','ZND1','ZND3','ZNDB','ZNE1','ZNRP')
),

Pedidos_Cat_Detailed AS (
    SELECT
        pc.[Fecha de Pedido],
        pc.[Fecha de Entrega_date],
        pc.[Solic.],
        pc.[Material],
        pc.[ClVt],
        CASE WHEN pc.[ClVt] NOT IN ('ZNRP', 'ZNE1') THEN pc.[Hls] ELSE 0 END AS HlsOrdenesTomadas,
        CASE WHEN pc.[Status] = 'no sumistrado' AND ISNULL(pc.[Motivo de Rechazo], '') = ''
             AND pc.[Month Entrega] = '02' AND pc.[Fecha de Entrega_date] <= CAST(GETDATE() AS DATE)
             THEN pc.[Hls] ELSE 0 END AS HlsPendientes,
        CASE WHEN pc.[ClVt] = 'ZNRP' AND pc.[Status] = 'no sumistrado'
             AND ISNULL(pc.[Motivo de Rechazo], '') = ''
             AND pc.[Month Entrega] = '02' AND pc.[Fecha de Entrega_date] <= CAST(GETDATE() AS DATE)
             THEN pc.[Hls] ELSE 0 END AS HlsReplanificados,
        CASE WHEN pc.[Status] = 'no sumistrado' AND ISNULL(pc.[Motivo de Rechazo], '') = ''
             AND pc.[Month Entrega] = '02' AND pc.[Fecha de Entrega_date] > CAST(GETDATE() AS DATE)
             THEN pc.[Hls] ELSE 0 END AS HlsPostFechados,
        CASE WHEN pc.[Status] = 'no sumistrado' AND ISNULL(pc.[Motivo de Rechazo], '') = ''
             AND (pc.[Year Entrega] > '2026' OR pc.[Month Entrega] > '02')
             THEN pc.[Hls] ELSE 0 END AS HlsPostFechadosMesSiguiente,
        CASE WHEN pc.[Status] = 'no sumistrado' AND pc.[Motivo de Rechazo] = '99'
             THEN pc.[Hls] ELSE 0 END AS HlsRechazoStockout,
        CASE WHEN pc.[Status] = 'no sumistrado' AND pc.[Motivo de Rechazo] = '08'
             THEN pc.[Hls] ELSE 0 END AS HlsRechazadosCredito,
        CASE WHEN pc.[Status] = 'no sumistrado'
             AND pc.[Motivo de Rechazo] != '99' AND pc.[Motivo de Rechazo] != '08'
             AND ISNULL(pc.[Motivo de Rechazo], '') != ''
             THEN pc.[Hls] ELSE 0 END AS HlsRechazadosOtros,
        0 AS EntregasAdelantadas
    FROM Pedidos_Classified pc
),

Pedidos_DateLevel AS (
    SELECT
        [Fecha de Pedido],
        [Fecha de Entrega_date],
        [Solic.],
        [Material],
        [ClVt],
        SUM(HlsOrdenesTomadas) AS HlsOrdenesTomadas,
        SUM(HlsPendientes) AS HlsPendientes,
        SUM(HlsReplanificados) AS HlsReplanificados,
        SUM(HlsPostFechados) AS HlsPostFechados,
        SUM(HlsPostFechadosMesSiguiente) AS HlsPostFechadosMesSiguiente,
        SUM(HlsRechazoStockout) AS HlsRechazoStockout,
        SUM(HlsRechazadosCredito) AS HlsRechazadosCredito,
        SUM(HlsRechazadosOtros) AS HlsRechazadosOtros,
        SUM(EntregasAdelantadas) AS EntregasAdelantadas
    FROM Pedidos_Cat_Detailed
    GROUP BY [Fecha de Pedido], [Fecha de Entrega_date], [Solic.], [Material], [ClVt]
),

Combined_Detailed AS (
    SELECT
        pdl.[Fecha de Pedido],
        pdl.[Fecha de Entrega_date],
        pdl.[Solic.],
        pdl.[Material],
        pdl.[ClVt],
        pdl.HlsOrdenesTomadas,
        pdl.HlsPendientes,
        pdl.HlsReplanificados,
        pdl.HlsPostFechados,
        pdl.HlsPostFechadosMesSiguiente,
        pdl.HlsPostFechados + pdl.HlsPostFechadosMesSiguiente AS HlsPostFechadosTotales,
        pdl.HlsRechazoStockout,
        pdl.HlsRechazadosCredito,
        pdl.HlsRechazadosOtros,
        ISNULL(oe.HlEntregados, 0) AS HlEntregados,
        pdl.HlsRechazoStockout - ISNULL(oe.HlEntregados, 0) AS StockOutTotal,
        ISNULL(tp.HlsTransportesPendientes, 0) AS HlsTransportesPendientes,
        ISNULL(vd.HlsVta, 0) AS HlsVta,
        ISNULL(tr.HlsTransportesRetrasados, 0) AS HlsTransportesRetrasados,
        ISNULL(ea.EntregasAdelantadas, 0) AS EntregasAdelantadas,
        ISNULL(fs.Sum_Hls_Devoluciones_Totales, 0) AS Hls_Devoluciones_Totales,
        ISNULL(fs.Sum_Hls_Devoluciones_Parciales, 0) AS Hls_Devoluciones_Parciales,
        ISNULL(fs.Sum_Hls_PBN, 0) AS Hls_PBN,
        ISNULL(fs.Sum_Hls_PBE_Visibles, 0) AS Hls_PBE_Visibles
    FROM Pedidos_DateLevel pdl
    LEFT JOIN OOS_Entregas_Detailed oe
        ON pdl.[Solic.] = oe.[Solic.] AND pdl.[Material] = oe.[Material]
        AND pdl.[Fecha de Pedido] = oe.[Fecha de Pedido] AND pdl.[Fecha de Entrega_date] = oe.[Fecha de Entrega_date]
    LEFT JOIN TransportesPendientes_Detailed tp
        ON pdl.[Solic.] = tp.[Solic.] AND pdl.[Material] = tp.[Material]
        AND pdl.[Fecha de Pedido] = tp.[Fecha de Pedido] AND pdl.[Fecha de Entrega_date] = tp.[Fecha de Entrega_date]
    LEFT JOIN VentasDiarias vd
        ON pdl.[Solic.] = vd.[Solic.] AND pdl.[Material] = vd.[Material]
        AND pdl.[Fecha de Entrega_date] = vd.[Fecha de Entrega_date]
    LEFT JOIN TransportesRetrasados tr
        ON pdl.[Solic.] = tr.[Solic.] AND pdl.[Material] = tr.[Material]
        AND pdl.[Fecha de Pedido] = tr.[Fecha de Pedido] AND pdl.[Fecha de Entrega_date] = tr.[Fecha de Entrega_date]
    LEFT JOIN EntregasAdelantadas ea
        ON pdl.[Solic.] = ea.[Solic.] AND pdl.[Material] = ea.[Material]
        AND pdl.[Fecha de Entrega_date] = ea.[Fecha de Entrega_date]
    LEFT JOIN Facturas_Summarized fs
        ON pdl.[Solic.] = fs.[Solic.] AND pdl.[Material] = fs.[Material]
        AND pdl.[Fecha de Entrega_date] = fs.[Fecha de Entrega_date]
),

Esetatus_Joined AS (
    SELECT
        cd.[Fecha de Pedido],
        cd.[Fecha de Entrega_date],
        sqvi.[Dirección],
        sqvi.[Región],
        sqvi.[Gerencia],
        sqvi.[ZV],
        sqvi.[Ce.],
        mat.[Product Category-Global],
        cd.[ClVt],
        SUM(cd.HlsOrdenesTomadas) AS HlsOrdenesTomadas,
        SUM(cd.HlsPendientes) AS HlsPendientes,
        SUM(cd.HlsReplanificados) AS HlsReplanificados,
        SUM(cd.HlsPostFechados) AS HlsPostFechados,
        SUM(cd.HlsPostFechadosMesSiguiente) AS HlsPostFechadosMesSiguiente,
        SUM(cd.HlsRechazoStockout) AS HlsRechazoStockout,
        SUM(cd.StockOutTotal) AS StockOutTotal,
        SUM(cd.HlEntregados) AS HlEntregados,
        SUM(cd.HlsRechazadosCredito) AS HlsRechazadosCredito,
        SUM(cd.HlsRechazadosOtros) AS HlsRechazadosOtros,
        SUM(cd.HlsPostFechadosTotales) AS HlsPostFechadosTotales,
        SUM(cd.HlsTransportesPendientes) AS HlsTransportesPendientes,
        SUM(cd.HlsVta) AS HlsVta,
        SUM(cd.HlsTransportesRetrasados) AS HlsTransportesRetrasados,
        SUM(cd.EntregasAdelantadas) AS EntregasAdelantadas,
        SUM(cd.Hls_Devoluciones_Totales) AS Hls_Devoluciones_Totales,
        SUM(cd.Hls_Devoluciones_Parciales) AS Hls_Devoluciones_Parciales,
        SUM(cd.Hls_PBN) AS Hls_PBN,
        SUM(cd.Hls_PBE_Visibles) AS Hls_PBE_Visibles
    FROM Combined_Detailed cd
    INNER JOIN [dbo].[SQVI] sqvi ON cd.[Solic.] = sqvi.[Cliente]
    INNER JOIN [dbo].[Materiales] mat ON cd.[Material] = mat.[Material]
    GROUP BY
        cd.[Fecha de Pedido], cd.[Fecha de Entrega_date],
        sqvi.[Dirección], sqvi.[Región], sqvi.[Gerencia], sqvi.[ZV], sqvi.[Ce.],
        mat.[Product Category-Global], cd.[ClVt]
)
INSERT INTO [dbo].[Esetatus_Pedidos_2018_M_2]
SELECT
    ej.[Fecha de Entrega_date],
    ej.[Dirección],
    ej.[Región],
    ej.[Gerencia],
    ej.[ZV],
    ej.[Ce.],
    ej.[Product Category-Global],
    SUM(ej.HlsOrdenesTomadas) AS HlsOrdenesTomadas,
    0 AS TomadasENTR,
    SUM(ej.HlsPendientes) AS HlsPendientes,
    SUM(ej.HlsReplanificados) AS HlsReplanificados,
    SUM(ej.HlsPostFechados) AS HlsPostFechados,
    SUM(ej.HlsPostFechadosMesSiguiente) AS HlsPostFechadosMesSiguiente,
    SUM(ej.HlsRechazoStockout) AS HlsRechazoStockout,
    SUM(ej.StockOutTotal) AS StockOutTotal,
    SUM(ej.HlEntregados) AS HlEntregados,
    SUM(ej.HlsRechazadosCredito) AS HlsRechazadosCredito,
    SUM(ej.HlsRechazadosOtros) AS HlsRechazadosOtros,
    SUM(ej.HlsPostFechadosTotales) AS HlsPostFechadosTotales,
    SUM(ej.HlsTransportesPendientes) AS HlsTransportesPendientes,
    SUM(ej.HlsVta) AS HlsVta,
    ISNULL(cq.HlsCuota, 0) AS HlsCuota,
    SUM(ej.HlsTransportesRetrasados) AS HlsTransportesRetrasados,
    SUM(ej.EntregasAdelantadas) AS EntregasAdelantadas,
    SUM(ej.Hls_Devoluciones_Totales) AS Hls_Devoluciones_Totales,
    SUM(ej.Hls_Devoluciones_Parciales) AS Hls_Devoluciones_Parciales,
    SUM(ej.Hls_PBN) AS Hls_PBN,
    SUM(ej.Hls_PBE_Visibles) AS Hls_PBE_Visibles,
    ej.[ClVt],
    CASE WHEN ej.[Fecha de Entrega_date] = CAST(GETDATE() AS DATE)
         THEN SUM(ej.HlsVta) + SUM(ej.HlsTransportesPendientes)
         ELSE SUM(ej.HlsVta) END AS HlsVta_Aj

FROM Esetatus_Joined ej
LEFT JOIN Cuota_Data cq
    ON ej.[Fecha de Entrega_date] = cq.[Fecha de Entrega_date]
    AND ej.[Dirección] = cq.[Dirección]
    AND ej.[Región] = cq.[Región]
    AND ej.[Gerencia] = cq.[Gerencia]
    AND ej.[ZV] = cq.[ZV]
    AND ej.[Product Category-Global] = cq.[Product Category-Global]
GROUP BY
    ej.[Fecha de Entrega_date], ej.[Dirección], ej.[Región], ej.[Gerencia], ej.[ZV],
    ej.[Ce.], ej.[Product Category-Global], ej.[ClVt], cq.HlsCuota;


