-- ============================================================================
-- OUTPUT 8: PedidosEntregas_1_2 (moved up - simple, only needs Pedidos_Base)
-- ============================================================================
;WITH Pedidos_Clean AS (
    SELECT
        p.[Solic.],
        p.[Material],
        p.[ClVt],
        p.[GVen],
        p.[UV],
        p.[Util.],
        p.[UM],
        REPLACE(REPLACE(LTRIM(RTRIM(p.[Volumen])), ',', ''), ' ', '') AS Volumen_Clean,
        REPLACE(REPLACE(LTRIM(RTRIM(p.[Cantidad_de_pedido])), ',', ''), ' ', '') AS Cantidaddepedido_Clean,
        LTRIM(RTRIM(p.[FePrefEnt.])) AS [FePrefEnt],
        p.[Doc._venta] AS [DocVenta],
        p.[Denominación],
        p.[CreadoPor],
        p.[ValorNeto],
        p.[Mon],
        p.[ClPed],
        p.[Num_Pedido],
        p.[MR] AS [Motivo de Rechazo],
        p.[SG] AS [Status_Raw],
        p.[Creado_el],
        RIGHT(p.[Creado_el], 2) + '-' + SUBSTRING(p.[Creado_el], 5, 2) + '-' + LEFT(p.[Creado_el], 4) AS Fecha_Str,
        RIGHT(LTRIM(RTRIM(p.[FePrefEnt.])), 2) + '-' + SUBSTRING(LTRIM(RTRIM(p.[FePrefEnt.])), 5, 2) + '-' + LEFT(LTRIM(RTRIM(p.[FePrefEnt.])), 4) AS FechaEntrega_Str
    FROM [dbo].[Pedidos] p
    WHERE p.[ClVt] != 'ClVt'
      AND p.[Doc._venta] != '4345611598'
),

Pedidos_WithDates AS (
    SELECT
        pc.*,
        TRY_CAST(pc.Fecha_Str AS DATE) AS [Fecha de Pedido],
        TRY_CAST(pc.FechaEntrega_Str AS DATE) AS [Fecha de Entrega_date],
        TRY_CAST(pc.Volumen_Clean AS FLOAT) AS Volumen,
        TRY_CAST(pc.Cantidaddepedido_Clean AS FLOAT) AS Cantidaddepedido
    FROM Pedidos_Clean pc
),

Pedidos_WithHls AS (
    SELECT
        pd.[Solic.],
        CAST(pd.[Material] AS VARCHAR(5)) AS [Material],
        pd.[ClVt],
        pd.[Motivo de Rechazo],
        pd.[Fecha de Pedido],
        pd.[Fecha de Entrega_date],
        DATEADD(DAY, 1, pd.[Fecha de Pedido]) AS [Fecha DSR],
        (pd.Volumen / 100000.0) * ISNULL(cp.[Signo], 1) AS [Hls],
        pd.[DocVenta],
        pd.Cantidaddepedido,
        pd.[GVen],
        pd.[Status_Raw],
        '02' AS [Month],
        '2026' AS [Year]
    FROM Pedidos_WithDates pd
    LEFT JOIN [dbo].[ClasesDePedidos] cp ON pd.[ClVt] = cp.[Clase doc.ventas]
),

Pedidos_Base AS (
    SELECT ph.*
    FROM Pedidos_WithHls ph
    LEFT JOIN [dbo].[EliminarMiller] em ON ph.[Material] = em.[Material]
    WHERE em.[Material] IS NULL
)

-- ============================================================================

INSERT INTO [dbo].[PedidosEntregas_1_2]
SELECT
    pb.[Fecha de Pedido],
    pb.[Fecha de Entrega_date],
    pb.[Solic.],
    pb.[Material],
    pb.[Hls],
    CASE WHEN pb.[Status_Raw] = 'A' THEN 'no sumistrado' WHEN pb.[Status_Raw] = 'B' THEN 'entregar parcialmente' WHEN pb.[Status_Raw] = 'C' THEN 'concluido/a' END AS [Status],
    pb.[Motivo de Rechazo],
    pb.[ClVt],
    pb.[Month],
    pb.[Year],
    pb.[DocVenta],
    pb.[Fecha DSR]
FROM Pedidos_Base pb;


-- ============================================================================
-- OUTPUT 7: TransportesRetrasados_2 (only needs Transporte_Clean)
-- ============================================================================
;WITH Transporte_Clean AS (
    SELECT DISTINCT
        t.[Transporte],
        t.[Material],
        t.[Solic.],
        t.[Creadoel] AS [Creadoel],
        t.[InPlanTran],
        t.[G] AS [Status],
        t.[ClEnt],
        t.[Entrega],
        TRY_CAST(REPLACE(REPLACE(LTRIM(RTRIM(t.[Volumen])), ',', ''), ' ', '') AS FLOAT) / 100000.0 AS Hls
