-- ============================================================================
-- SQL Translation of Alteryx Workflow: Pedidos
-- For execution in Pentaho on SQL Server (WarehousePanama)
-- ============================================================================
-- FIX v7: Each output is a self-contained statement with its own CTEs.
-- No temp tables, no DECLARE variables, no cross-statement CTE references.
-- All lookups inlined as CTEs/CASE/IN clauses (following DSR pattern).
--   Pedidos: Creado_el, Doc._venta, Cantidad_de_pedido, FePrefEnt., FePrefEnt._1
--   2018_Mes_D_Fact: Doc._venta, Doc.venta (two separate columns)
-- ============================================================================
-- OUTPUT TABLES:
--   1. Detalle_2
--   2. ResumenCategorias_2
--   3. Detalle_Clientes_2
--   4. Esetatus_Pedidos_2018_M_2
--   5. concilia_pedidos_rechazados_otros_2
--   6. pedidos_rechazados_2
--   7. TransportesRetrasados_2
--   8. PedidosEntregas_1_2
-- ============================================================================

USE WarehousePanama;

-- ============================================================================
-- PARAMETERS: Month='02', Year='2026' (hardcoded inline - update in all
-- occurrences of '02' for month and '2026' for year when changing period)
-- ============================================================================

-- ============================================================================
-- CLEANUP
-- ============================================================================
TRUNCATE TABLE [dbo].[Detalle_2];
TRUNCATE TABLE [dbo].[ResumenCategorias_2];
TRUNCATE TABLE [dbo].[Detalle_Clientes_2];
TRUNCATE TABLE [dbo].[Esetatus_Pedidos_2018_M_2];
TRUNCATE TABLE [dbo].[concilia_pedidos_rechazados_otros_2];
TRUNCATE TABLE [dbo].[pedidos_rechazados_2];
TRUNCATE TABLE [dbo].[TransportesRetrasados_2];
TRUNCATE TABLE [dbo].[PedidosEntregas_1_2];

-- ============================================================================
-- STREAM A: PEDIDOS BASE DATA PROCESSING
-- ============================================================================
-- Pedidos schema columns:
--   Creado_el, Doc._venta, ClVt, Solic., Material, Denominación,
--   Cantidad_de_pedido, UM, Volumen, UV, Util., FePrefEnt._1, Referencia,
--   MR, SG, CreadoPor, Mon, GVen, FePrefEnt., ValorNeto, ClPed, Num_Pedido
-- ============================================================================


-- ============================================================================
-- OUTPUT 1: Detalle_2
-- ============================================================================
;WITH Pedidos_Clean AS (
    SELECT
        p.[Solic.],
        p.[Material],
        p.[ClVt],
        p.[GVen],
        p.[UV],
        p.[Util.],
        p.[UM],
        REPLACE(REPLACE(LTRIM(RTRIM(p.[Volumen])), ',', ''), ' ', '') AS Volumen_Clean,
        REPLACE(REPLACE(LTRIM(RTRIM(p.[Cantidad_de_pedido])), ',', ''), ' ', '') AS Cantidaddepedido_Clean,
        LTRIM(RTRIM(p.[FePrefEnt.])) AS [FePrefEnt],
        p.[Doc._venta] AS [DocVenta],
        p.[Denominación],
        p.[CreadoPor],
        p.[ValorNeto],
        p.[Mon],
        p.[ClPed],
        p.[Num_Pedido],
        p.[MR] AS [Motivo de Rechazo],
        p.[SG] AS [Status_Raw],
        p.[Creado_el],
        RIGHT(p.[Creado_el], 2) + '-' + SUBSTRING(p.[Creado_el], 5, 2) + '-' + LEFT(p.[Creado_el], 4) AS Fecha_Str,
        RIGHT(LTRIM(RTRIM(p.[FePrefEnt.])), 2) + '-' + SUBSTRING(LTRIM(RTRIM(p.[FePrefEnt.])), 5, 2) + '-' + LEFT(LTRIM(RTRIM(p.[FePrefEnt.])), 4) AS FechaEntrega_Str
    FROM [dbo].[Pedidos] p
    WHERE p.[ClVt] != 'ClVt'
      AND p.[Doc._venta] != '4345611598'
),

Pedidos_WithDates AS (
    SELECT
        pc.*,
        TRY_CAST(pc.Fecha_Str AS DATE) AS [Fecha de Pedido],
        TRY_CAST(pc.FechaEntrega_Str AS DATE) AS [Fecha de Entrega_date],
        TRY_CAST(pc.Volumen_Clean AS FLOAT) AS Volumen,
        TRY_CAST(pc.Cantidaddepedido_Clean AS FLOAT) AS Cantidaddepedido
    FROM Pedidos_Clean pc
),

Pedidos_WithHls AS (
    SELECT
        pd.[Solic.],
        CAST(pd.[Material] AS VARCHAR(5)) AS [Material],
        pd.[ClVt],
        pd.[Motivo de Rechazo],
        pd.[Fecha de Pedido],
        pd.[Fecha de Entrega_date],
        DATEADD(DAY, 1, pd.[Fecha de Pedido]) AS [Fecha DSR],
        (pd.Volumen / 100000.0) * ISNULL(cp.[Signo], 1) AS [Hls],
        pd.[DocVenta],
        pd.Cantidaddepedido,
        pd.[GVen],
        pd.[Status_Raw],
        '02' AS [Month],
        '2026' AS [Year]
    FROM Pedidos_WithDates pd
    LEFT JOIN [dbo].[ClasesDePedidos] cp ON pd.[ClVt] = cp.[Clase doc.ventas]
),

Pedidos_Base AS (
    SELECT ph.*
    FROM Pedidos_WithHls ph
    LEFT JOIN [dbo].[EliminarMiller] em ON ph.[Material] = em.[Material]
    WHERE em.[Material] IS NULL
),

-- ============================================================================,

OrdenesTomadas AS (
    SELECT
        pb.[Solic.],
        pb.[Material],
        SUM(pb.[Hls]) AS HlsOrdenesTomadas
    FROM Pedidos_Base pb
    WHERE pb.[ClVt] NOT IN ('ZNRP', 'ZNE1')
    GROUP BY pb.[Solic.], pb.[Material]
),

-- ============================================================================
-- STREAM A2: Pedidos through Status/Rechazo classification
-- ============================================================================
Pedidos_Summarized AS (
    SELECT
        pb.[Fecha de Pedido],
        pb.[Fecha de Entrega_date],
        pb.[Solic.],
        pb.[Material],
        SUM(pb.[Hls]) AS Sum_Hls,
        CASE WHEN pb.[Status_Raw] = 'A' THEN 'no sumistrado' WHEN pb.[Status_Raw] = 'B' THEN 'entregar parcialmente' WHEN pb.[Status_Raw] = 'C' THEN 'concluido/a' END AS [Status],
        pb.[Motivo de Rechazo],
        pb.[ClVt],
        pb.[Month],
        pb.[Year]
    FROM Pedidos_Base pb
    WHERE pb.[ClVt] IN ('ZNP1','ZNPV','ZNO1','ZNOB','ZND1','ZND3','ZNDB','ZNE1','ZNRP')
    GROUP BY
        pb.[Fecha de Pedido], pb.[Fecha de Entrega_date], pb.[Solic.], pb.[Material],
        pb.[Status_Raw], pb.[Motivo de Rechazo], pb.[ClVt], pb.[Month], pb.[Year]
),

Pedidos_WithEntregaMonth AS (
    SELECT
        ps.*,
        RIGHT('0' + CAST(MONTH(ps.[Fecha de Entrega_date]) AS VARCHAR(2)), 2) AS [Month Entrega],
        CAST(YEAR(ps.[Fecha de Entrega_date]) AS VARCHAR(4)) AS [Year Entrega]
    FROM Pedidos_Summarized ps
),

-- ============================================================================
-- CLASSIFICATION CTEs
-- ============================================================================

HlsPendientes AS (
    SELECT [Solic.], [Material], Sum_Hls AS HlsPendientes,
           [Fecha de Pedido], [Fecha de Entrega_date], [ClVt]
    FROM Pedidos_WithEntregaMonth
    WHERE [Status] = 'no sumistrado'
      AND (ISNULL([Motivo de Rechazo], '') = '')
      AND [Month Entrega] = '02'
      AND [Fecha de Entrega_date] <= CAST(GETDATE() AS DATE)
),

HlsPostFechados AS (
    SELECT [Solic.], [Material], Sum_Hls AS HlsPostFechados,
           [Fecha de Pedido], [Fecha de Entrega_date], [ClVt]
    FROM Pedidos_WithEntregaMonth
    WHERE [Status] = 'no sumistrado'
      AND (ISNULL([Motivo de Rechazo], '') = '')
      AND [Month Entrega] = '02'
      AND [Fecha de Entrega_date] > CAST(GETDATE() AS DATE)
),

HlsPostFechadosMesSiguiente AS (
    SELECT [Solic.], [Material], Sum_Hls AS HlsPostFechadosMesSiguiente,
           [Fecha de Pedido], [Fecha de Entrega_date], [ClVt]
    FROM Pedidos_WithEntregaMonth
    WHERE [Status] = 'no sumistrado'
      AND (ISNULL([Motivo de Rechazo], '') = '')
      AND ([Year Entrega] > '2026' OR [Month Entrega] > '02')
),

HlsRechazoStockout AS (
    SELECT [Solic.], [Material], Sum_Hls AS HlsRechazoStockout,
           [Fecha de Pedido], [Fecha de Entrega_date], [ClVt]
    FROM Pedidos_WithEntregaMonth
    WHERE [Status] = 'no sumistrado'
      AND [Motivo de Rechazo] = '99'
),

HlsRechazadosCredito AS (
    SELECT [Solic.], [Material], Sum_Hls AS HlsRechazadosCredito,
           [Fecha de Pedido], [Fecha de Entrega_date], [ClVt]
    FROM Pedidos_WithEntregaMonth
    WHERE [Status] = 'no sumistrado'
      AND [Motivo de Rechazo] = '08'
),

HlsRechazadosOtros AS (
    SELECT [Solic.], [Material], Sum_Hls AS HlsRechazadosOtros,
           [Motivo de Rechazo],
           [Fecha de Pedido], [Fecha de Entrega_date], [ClVt]
    FROM Pedidos_WithEntregaMonth
    WHERE [Status] = 'no sumistrado'
      AND [Motivo de Rechazo] != '99'
      AND [Motivo de Rechazo] != '08'
      AND ISNULL([Motivo de Rechazo], '') != ''
),

HlsReplanificados AS (
    SELECT [Solic.], [Material], Sum_Hls AS HlsReplanificados,
           [Fecha de Pedido], [Fecha de Entrega_date], [ClVt]
    FROM Pedidos_WithEntregaMonth
    WHERE [Status] = 'no sumistrado'
      AND (ISNULL([Motivo de Rechazo], '') = '')
      AND [ClVt] = 'ZNRP'
      AND [Month Entrega] = '02'
      AND [Fecha de Entrega_date] <= CAST(GETDATE() AS DATE)
),

-- ============================================================================,

OOS_Entregas AS (
    SELECT
        oos.[Solic.],
        oos.[Material],
        SUM(TRY_CAST(REPLACE(REPLACE(LTRIM(RTRIM(oos.[Volumen])), ',', ''), ' ', '') AS FLOAT) / 100000.0) AS HlEntregados
    FROM [dbo].[OOS] oos
    WHERE oos.[Fecha_doc.] = '2024.02.28'  -- TODO: UPDATE THIS DATE PARAMETER
    GROUP BY oos.[Solic.], oos.[Material]
),

OOS_Entregas_Detailed AS (
    SELECT
        TRY_CAST(
            RIGHT(oos.[Fechadoc.], 2) + '-' + SUBSTRING(oos.[Fechadoc.], 5, 2) + '-' + LEFT(oos.[Fechadoc.], 4)
        AS DATE) AS [Fecha de Pedido],
        TRY_CAST(
            RIGHT(oos.[FePrefEnt.], 2) + '-' + SUBSTRING(oos.[FePrefEnt.], 5, 2) + '-' + LEFT(oos.[FePrefEnt.], 4)
        AS DATE) AS [Fecha de Entrega_date],
        oos.[Solic.],
        oos.[Material],
        SUM(TRY_CAST(REPLACE(REPLACE(LTRIM(RTRIM(oos.[Volumen])), ',', ''), ' ', '') AS FLOAT) / 100000.0) AS HlEntregados
    FROM [dbo].[OOS] oos
    WHERE oos.[Fecha_doc.] = '2024.02.28'  -- TODO: UPDATE THIS DATE PARAMETER
    GROUP BY
        oos.[Fechadoc.], oos.[FePrefEnt.], oos.[Solic.], oos.[Material]
),

-- ============================================================================,

Transporte_Clean AS (
    SELECT DISTINCT
        t.[Transporte],
        t.[Material],
        t.[Solic.],
        t.[Creadoel] AS [Creadoel],
        t.[InPlanTran],
        t.[G] AS [Status],
        t.[ClEnt],
        t.[Entrega],
        TRY_CAST(REPLACE(REPLACE(LTRIM(RTRIM(t.[Volumen])), ',', ''), ' ', '') AS FLOAT) / 100000.0 AS Hls
    FROM [dbo].[Transporte] t
    WHERE ISNULL(t.[Material], '') != ''
      AND t.[Material] != 'Material'
),

TransportesPendientes AS (
    SELECT
        tc.[Material],
        tc.[Solic.],
        SUM(tc.Hls) AS HlsTransportesPendientes
    FROM Transporte_Clean tc
    WHERE (tc.[ClEnt] = 'ZNP1' OR tc.[ClEnt] = 'ZNO1')
      AND (tc.[Status] = '1' OR tc.[Status] = '0')
    GROUP BY tc.[Material], tc.[Solic.]
),

TransportesPendientes_Detailed AS (
    SELECT
        TRY_CAST(
            RIGHT(tc.[Creadoel], 2) + '-' + SUBSTRING(tc.[Creadoel], 5, 2) + '-' + LEFT(tc.[Creadoel], 4)
        AS DATE) AS [Fecha de Pedido],
        TRY_CAST(
            RIGHT(tc.[InPlanTran], 2) + '-' + SUBSTRING(tc.[InPlanTran], 5, 2) + '-' + LEFT(tc.[InPlanTran], 4)
        AS DATE) AS [Fecha de Entrega_date],
        tc.[Material],
        tc.[Solic.],
        SUM(tc.Hls) AS HlsTransportesPendientes
    FROM Transporte_Clean tc
    WHERE (tc.[ClEnt] = 'ZNP1' OR tc.[ClEnt] = 'ZNO1')
      AND (tc.[Status] = '1' OR tc.[Status] = '0')
    GROUP BY tc.[Creadoel], tc.[InPlanTran], tc.[Material], tc.[Solic.]
),

TransportesRetrasados_Base AS (
    SELECT
        TRY_CAST(
            RIGHT(tc.[Creadoel], 2) + '-' + SUBSTRING(tc.[Creadoel], 5, 2) + '-' + LEFT(tc.[Creadoel], 4)
        AS DATE) AS [Fecha de Pedido],
        TRY_CAST(
            RIGHT(tc.[InPlanTran], 2) + '-' + SUBSTRING(tc.[InPlanTran], 5, 2) + '-' + LEFT(tc.[InPlanTran], 4)
        AS DATE) AS [Fecha de Entrega_date],
        tc.[Material],
        tc.[Solic.],
        SUM(tc.Hls) AS HlsTransportesRetrasados
    FROM Transporte_Clean tc
    WHERE (tc.[ClEnt] = 'ZNP1' OR tc.[ClEnt] = 'ZNO1')
      AND tc.[Status] != '7'
    GROUP BY tc.[Creadoel], tc.[InPlanTran], tc.[Material], tc.[Solic.]
),

TransportesRetrasados AS (
    SELECT
        [Fecha de Pedido],
        [Fecha de Entrega_date],
        [Material],
        [Solic.],
        CASE WHEN [Fecha de Entrega_date] = CAST(GETDATE() AS DATE) THEN 0
             ELSE HlsTransportesRetrasados END AS HlsTransportesRetrasados
    FROM TransportesRetrasados_Base
),

-- ============================================================================,

Ventas AS (
    SELECT
        m.[Customer Code] AS [Solic.],
        m.[Material],
        SUM(m.[Sales Volume (HL) - BIL]) AS HlsVentas
    FROM [dbo].[2018_Mes] m
    GROUP BY m.[Customer Code], m.[Material]
),

-- ============================================================================,

AllOrders_Union AS (
    SELECT [Solic.], [Material],
           HlsOrdenesTomadas, 0 AS HlsVentas, 0 AS HlsPendientes, 0 AS HlsReplanificados,
           0 AS HlsPostFechados, 0 AS HlsPostFechadosMesSiguiente,
           0 AS HlsRechazoStockout, 0 AS HlsRechazadosCredito, 0 AS HlsRechazadosOtros
    FROM OrdenesTomadas

    UNION ALL

    SELECT [Solic.], [Material],
           0, 0, HlsPendientes, 0, 0, 0, 0, 0, 0
    FROM HlsPendientes

    UNION ALL

    SELECT [Solic.], [Material],
           0, 0, 0, 0, HlsPostFechados, 0, 0, 0, 0
    FROM HlsPostFechados

    UNION ALL

    SELECT [Solic.], [Material],
           0, 0, 0, 0, 0, HlsPostFechadosMesSiguiente, 0, 0, 0
    FROM HlsPostFechadosMesSiguiente

    UNION ALL

    SELECT [Solic.], [Material],
           0, 0, 0, 0, 0, 0, HlsRechazoStockout, 0, 0
    FROM HlsRechazoStockout

    UNION ALL

    SELECT [Solic.], [Material],
           0, 0, 0, 0, 0, 0, 0, HlsRechazadosCredito, 0
    FROM HlsRechazadosCredito

    UNION ALL

    SELECT [Solic.], [Material],
           0, 0, 0, 0, 0, 0, 0, 0, HlsRechazadosOtros
    FROM HlsRechazadosOtros

    UNION ALL

    SELECT [Solic.], [Material],
           0, 0, 0, HlsReplanificados, 0, 0, 0, 0, 0
    FROM HlsReplanificados

    UNION ALL

    SELECT [Solic.], [Material],
           0, HlsVentas, 0, 0, 0, 0, 0, 0, 0
    FROM Ventas
),

Orders_Summarized AS (
    SELECT
        [Solic.], [Material],
        SUM(HlsOrdenesTomadas) AS HlsOrdenesTomadas,
        SUM(HlsVentas) AS HlsVentas,
        SUM(HlsPendientes) AS HlsPendientes,
        SUM(HlsReplanificados) AS HlsReplanificados,
        SUM(HlsPostFechados) AS HlsPostFechados,
        SUM(HlsPostFechadosMesSiguiente) AS HlsPostFechadosMesSiguiente,
        SUM(HlsRechazoStockout) AS HlsRechazoStockout,
        SUM(HlsRechazadosCredito) AS HlsRechazadosCredito,
        SUM(HlsRechazadosOtros) AS HlsRechazadosOtros
    FROM AllOrders_Union
    GROUP BY [Solic.], [Material]
),

AllMetrics AS (
    SELECT
        os.[Solic.], os.[Material],
        os.HlsOrdenesTomadas,
        os.HlsVentas,
        os.HlsPendientes,
        os.HlsReplanificados,
        os.HlsPostFechados,
        os.HlsPostFechadosMesSiguiente,
        os.HlsRechazoStockout,
        os.HlsRechazadosCredito,
        os.HlsRechazadosOtros,
        os.HlsPostFechados + os.HlsPostFechadosMesSiguiente AS HlsPostFechadosTotales,
        ISNULL(oe.HlEntregados, 0) AS HlEntregados,
        ISNULL(tp.HlsTransportesPendientes, 0) AS HlsTransportesPendientes
    FROM Orders_Summarized os
    LEFT JOIN OOS_Entregas oe ON os.[Solic.] = oe.[Solic.] AND os.[Material] = oe.[Material]
    LEFT JOIN TransportesPendientes tp ON os.[Solic.] = tp.[Solic.] AND os.[Material] = tp.[Material]
),

AllMetrics_WithStockout AS (
    SELECT
        am.*,
        am.HlsRechazoStockout - am.HlEntregados AS StockOutTotal
    FROM AllMetrics am
)

-- ============================================================================

INSERT INTO [dbo].[Detalle_2]
SELECT
    sqvi.[Dirección],
    sqvi.[Región],
    sqvi.[Gerencia],
    sqvi.[ZV],
    sqvi.[Ce.],
    am.[Solic.] AS [Cliente],
    sqvi.[Nombre 3],
    mat.[Product Category-Global],
    mat.[Brand-Local],
    mat.[Capacity],
    SUM(am.HlsOrdenesTomadas) AS HlsOrdenesTomadas,
    SUM(am.HlsVentas) AS HlsVentas,
    SUM(am.HlsPendientes) AS HlsPendientes,
    SUM(am.HlsReplanificados) AS HlsReplanificados,
    SUM(am.HlsPostFechados) AS HlsPostFechados,
    SUM(am.HlsPostFechadosMesSiguiente) AS HlsPostFechadosMesSiguiente,
    SUM(am.HlsRechazoStockout) AS HlsRechazoStockout,
    SUM(am.StockOutTotal) AS StockOutTotal,
    SUM(am.HlEntregados) AS HlEntregados,
    SUM(am.HlsRechazadosCredito) AS HlsRechazadosCredito,
    SUM(am.HlsRechazadosOtros) AS HlsRechazadosOtros,
    SUM(am.HlsPostFechadosTotales) AS HlsPostFechadosTotales,
    SUM(am.HlsTransportesPendientes) AS HlsTransportesPendientes

FROM AllMetrics_WithStockout am
INNER JOIN [dbo].[SQVI] sqvi ON am.[Solic.] = sqvi.[Cliente]
INNER JOIN [dbo].[Materiales] mat ON am.[Material] = mat.[Material]
GROUP BY
    sqvi.[Dirección], sqvi.[Región], sqvi.[Gerencia], sqvi.[ZV], sqvi.[Ce.],
    am.[Solic.], sqvi.[Nombre 3], mat.[Product Category-Global], mat.[Brand-Local], mat.[Capacity];


-- ============================================================================


-- ============================================================================
-- OUTPUT 2: ResumenCategorias_2
-- ============================================================================
INSERT INTO [dbo].[ResumenCategorias_2]
SELECT
    [Dirección], [Región], [Gerencia], [ZV], [Ce.], [Product Category-Global],
    SUM(HlsOrdenesTomadas) AS HlsOrdenesTomadas,
    SUM(HlsVentas) AS HlsVentas,
    SUM(HlsPendientes) AS HlsPendientes,
    SUM(HlsReplanificados) AS HlsReplanificados,
    SUM(StockOutTotal) AS StockOutTotal,
    SUM(HlsRechazadosCredito) AS Sum_HlsRechazadosCredito,
    SUM(HlsRechazadosOtros) AS Sum_HlsRechazadosOtros,
    SUM(HlsPostFechadosTotales) AS Sum_HlsPostFechadosTotales,
    SUM(HlsTransportesPendientes) AS Sum_HlsTransportesPendientes

FROM [dbo].[Detalle_2]
GROUP BY [Dirección], [Región], [Gerencia], [ZV], [Ce.], [Product Category-Global];


