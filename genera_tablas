-- ============================================================================
-- OUTPUT: GAPs_2_2 - Beer YoY and MoM comparison
-- 3-way FULL OUTER JOIN so LM-only customer+material combos are included
-- ============================================================================

-- Beer MTD current (from stg_gd_with_proj which now has correct Hls)
EXEC('SELECT [Material], [Customer Code], [Nombre Cliente], SUM(ISNULL(Hls,0)) AS Hls_mtd
INTO dbo.stg_gd_gaps_mtd
FROM dbo.stg_gd_with_proj WHERE [Categoría] = ''Beer''
GROUP BY [Material], [Customer Code], [Nombre Cliente]');

-- Beer MTD Last Year
EXEC('SELECT CAST(LTRIM(RTRIM(d.[Material])) AS VARCHAR(20)) AS [Material],
    d.[Customer Code], SUM(d.[Sales Volume (HL) - BIL]) AS Hls_mtd_ly
INTO dbo.stg_gd_gaps_ly
FROM [dbo].[2017_M_D] d
INNER JOIN [dbo].[Materiales] mat ON CAST(LTRIM(RTRIM(d.[Material])) AS VARCHAR(20)) = mat.[Material]
WHERE mat.[Product Category-Global] = ''Beer'' AND d.[Calendar Day] <= DATEADD(YEAR, -1, GETDATE())
GROUP BY CAST(LTRIM(RTRIM(d.[Material])) AS VARCHAR(20)), d.[Customer Code]');

-- Beer MTD Last Month (HistoricosPanama)
EXEC('SELECT CAST(LTRIM(RTRIM(d.[Material])) AS VARCHAR(20)) AS [Material],
    d.[Customer Code], SUM(d.[Sales Volume (HL) - BIL]) AS Hls_mtd_lm
INTO dbo.stg_gd_gaps_lm
FROM [HistoricosPanama].[dbo].[2026_02_D] d
INNER JOIN [dbo].[Materiales] mat ON CAST(LTRIM(RTRIM(d.[Material])) AS VARCHAR(20)) = mat.[Material]
WHERE mat.[Product Category-Global] = ''Beer'' AND d.[Calendar Day] <= DATEADD(MONTH, -1, GETDATE())
GROUP BY CAST(LTRIM(RTRIM(d.[Material])) AS VARCHAR(20)), d.[Customer Code]');

-- 3-way FULL OUTER JOIN: current + LY + LM, then LEFT JOIN Materiales for Marca
EXEC('SELECT
    COALESCE(c.[Material], ly.[Material], lm.[Material]) AS Material,
    COALESCE(c.[Customer Code], ly.[Customer Code], lm.[Customer Code]) AS [Customer Code],
    c.[Nombre Cliente],
    ISNULL(c.Hls_mtd, 0) AS Hls_mtd,
    ISNULL(ly.Hls_mtd_ly, 0) AS Hls_mtd_ly,
    COALESCE(c.Hls_mtd / NULLIF(ly.Hls_mtd_ly, 0), 0) AS [%_ly],
    ISNULL(lm.Hls_mtd_lm, 0) AS Hls_mtd_lm,
    COALESCE(c.Hls_mtd / NULLIF(lm.Hls_mtd_lm, 0), 0) AS [%_lm],
    mat.[Brand-Local] AS Marca, mat.[Capacity]
INTO [dbo].[GAPs_2_2]
FROM dbo.stg_gd_gaps_mtd c
FULL OUTER JOIN dbo.stg_gd_gaps_ly ly
    ON c.[Customer Code] = ly.[Customer Code] AND c.[Material] = ly.[Material]
FULL OUTER JOIN dbo.stg_gd_gaps_lm lm
    ON COALESCE(c.[Customer Code], ly.[Customer Code]) = lm.[Customer Code]
    AND COALESCE(c.[Material], ly.[Material]) = lm.[Material]
LEFT JOIN [dbo].[Materiales] mat
    ON COALESCE(c.[Material], ly.[Material], lm.[Material]) = mat.[Material]');


